# PostgreSQL (roles de mínimo privilegio, infra/postgres/init/01-roles.sh)
POSTGRES_SUPERUSER_PASSWORD=cambiar-superusuario
STOCKEA_MIGRATOR_PASSWORD=cambiar-migrator
STOCKEA_APP_PASSWORD=cambiar-app
STOCKEA_MONITOR_PASSWORD=cambiar-monitor
KEYCLOAK_DB_PASSWORD=cambiar-keycloak-db

# Keycloak (Identity Provider)
KEYCLOAK_ADMIN_PASSWORD=cambiar-admin-keycloak
STOCKEA_API_CLIENT_SECRET=cambiar-secreto-cliente-api
# URL pública de Keycloak detrás del gateway (es el "iss" de los tokens)
KEYCLOAK_PUBLIC_URL=https://localhost/auth
# Orígenes permitidos para volver del login: el gateway y Vite en desarrollo
STOCKEA_WEB_URL=https://localhost
STOCKEA_DEV_WEB_URL=http://localhost:5173

# RabbitMQ (cada aplicación con su propio usuario)
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=cambiar-admin-rabbitmq
RABBITMQ_API_PASSWORD=cambiar-rabbitmq-api
RABBITMQ_WORKER_PASSWORD=cambiar-rabbitmq-worker

# Grafana
GRAFANA_ADMIN_PASSWORD=cambiar-admin-grafana

# Gateway: 127.0.0.1 = solo este computador. 0.0.0.0 = también el celular en la misma red.
GATEWAY_BIND=127.0.0.1
# WAF del gateway: On = bloquea (por defecto); DetectionOnly = solo registra en el log (para diagnosticar falsos positivos)
# WAF_MODO=On
